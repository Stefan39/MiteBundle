{
    "name": "stejac/mite-bundle",
    "description": "Symfony bundle for the mite time tracking API: typed services and DTOs for every resource.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["mite", "symfony", "symfony-bundle", "time-tracking", "api-client"],
    "homepage": "https://github.com/Stefan39/MiteBundle",
    "authors": [
        {
            "name": "Stefan Jacomeit",
            "email": "stefan@jacomeit.de",
            "homepage": "https://www.jacomeit.de"
        }
    ],
    "require": {
        "php": ">=8.3",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "symfony/framework-bundle": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Stejac\\MiteBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stejac\\MiteBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-live": "phpunit --testsuite live",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
